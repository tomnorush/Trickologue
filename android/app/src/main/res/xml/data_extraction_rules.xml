<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: the progress file follows the tricker to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="progress.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="progress.json" />
    </device-transfer>
</data-extraction-rules>
